-- TEAM CHECK
local function sameTeam(plr)
	if not TEAM_CHECK then return false end
	if not plr.Team or not player.Team then return false end
	return plr.Team == player.Team
end

-- TARGET FIND
local function getClosestTarget()
	local closest, shortest = nil, AIM_FOV
	for _,plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and plr.Character and plr.Character:FindFirstChild(AIM_PART) then
			if not sameTeam(plr) then
				local part = plr.Character[AIM_PART]
				local pos, vis = camera:WorldToViewportPoint(part.Position)
				if vis then
					local dist = (Vector2.new(pos.X,pos.Y)-Vector2.new(mouse.X,mouse.Y)).Magnitude
					if dist < shortest then
						shortest = dist
						closest = part
					end
				end
			end
		end
	end
	return closest
end

-- TRIGGERBOT
local function triggerFire()
	mouse1press()
	task.wait(0.04)
	mouse1release()
end

-- 🔥 INPUT FIX (PC + MOBILE)
RunService.RenderStepped:Connect(function()
	if UIS.MouseEnabled then
		inputDelta = UIS:GetMouseDelta()
	end
end)

UIS.TouchMoved:Connect(function(touch, gpe)
	if gpe then return end
	inputDelta = touch.Delta
end)

-- 🔥 AIM LOOP FIXED (FINAL)
connections.aim = RunService.RenderStepped:Connect(function()
	if not AIM_ENABLED then
		LOCKED_TARGET = nil
		return
	end

	-- solta alvo se mover mouse ou dedo
	if math.abs(inputDelta.X) > DEADZONE or math.abs(inputDelta.Y) > DEADZONE then
		LOCKED_TARGET = nil
	end

	if not LOCKED_TARGET or not LOCKED_TARGET.Parent then
		LOCKED_TARGET = getClosestTarget()
	end

	if LOCKED_TARGET then
		local camPos = camera.CFrame.Position
		camera.CFrame = camera.CFrame:Lerp(
			CFrame.new(camPos, LOCKED_TARGET.Position),
			AIM_SMOOTH
		)

		if TRIGGERBOT then
			triggerFire()
		end
	end
end)

-- ACTIONS
local actions = {
	["Aimbot"] = function(on) AIM_ENABLED = on end,
	["Triggerbot"] = function(on) TRIGGERBOT = on end,
	["Team Check"] = function(on) TEAM_CHECK = on end,
	["Aim Head"] = function(on) if on then AIM_PART="Head" LOCKED_TARGET=nil end end,
	["Aim Torso"] = function(on) if on then AIM_PART="HumanoidRootPart" LOCKED_TARGET=nil end end,

	["WalkSpeed"] = function(on) getChar().Humanoid.WalkSpeed = on and 32 or 16 end,
	["JumpPower"] = function(on) getChar().Humanoid.JumpPower = on and 80 or 50 end,

	["Full Bright"] = function(on) Lighting.Brightness = on and 3 or 1 end,
	["Custom FOV"] = function(on) camera.FieldOfView = on and 90 or 70 end,

	["Anti AFK"] = function(on)
		if on then
			connections.afk = player.Idled:Connect(function()
				VirtualUser:Button2Down(Vector2.new(),camera.CFrame)
				task.wait(1)
				VirtualUser:Button2Up(Vector2.new(),camera.CFrame)
			end)
		elseif connections.afk then
			connections.afk:Disconnect()
		end
	end,

	["Rejoin"] = function() TeleportService:Teleport(game.PlaceId,player) end,
	["Unload"] = function() gui:Destroy() end
}

